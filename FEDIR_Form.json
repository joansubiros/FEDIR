uato\", \"El Talar\", \"General Pacheco\", \"Ricardo Rojas\", \"Tigre\", \"Troncos del Talar\"], \"Tordillo\": [\"General Conesa\"], \"Tornquist\": [\"Chasicó\", \"Saldungaray\", \"Sierra de la Ventana\", \"Tornquist\", \"Villa Serrana La Gruta\", \"Villa Ventana\"], \"Trenque Lauquen\": [\"30 de Agosto\", \"Beruti\", \"Girodias\", \"Trenque Lauquen\"], \"Tres Arroyos\": [\"Claromecó\", \"Copetonas\", \"Dunamar\", \"Micaela Cascallares\", \"Orense\", \"Reta\", \"San Francisco de Bellocq\", \"San Mayol\", \"Tres Arroyos\"], \"Tres de Febrero\": [\"11 de Septiembre\", \"Caseros\", \"Churruca\", \"Ciudad Jardín Lomas del Palomar\", \"Ciudadela\", \"El Libertador\", \"José Ingenieros\", \"Loma Hermosa\", \"Martín Coronado\", \"Pablo Podestá\", \"Remedios de Escalada\", \"Sáenz Peña\", \"Santos Lugares\", \"Tres de Febrero\", \"Villa Bosch\", \"Villa Raffo\"], \"Tres Lomas\": [\"Ingeniero Thompson\", \"Tres Lomas\"], \"Vicente López\": [\"Carapachay\", \"Florida\", \"Florida Oeste\", \"La Lucila\", \"Munro\", \"Olivos\", \"Vicente López\", \"Villa Adelina\", \"Villa Martelli\"], \"Villa Gesell\": [\"Mar Azul\", \"Mar de las Pampas\", \"Villa Gesell\"], \"Villarino\": [\"Argerich\", \"Hilario Ascasubi\", \"Juan CoustÉ\", \"Mayor Buratovich\", \"Médanos\", \"Pedro Luro\"], \"Zárate\": [\"Escalada\", \"Lima\", \"Zárate\"]}, \"CABA\": {\"Capital Federal\": [\"AGRONOMIA\", \"ALMAGRO\", \"BALVANERA\", \"BARRACAS\", \"BELGRANO\", \"BOEDO\", \"CABALLITO\", \"CHACARITA\", \"CIUDAD DE BUENOS AIRES\", \"COGHLAN\", \"COLEGIALES\", \"CONSTITUCION\", \"FLORES\", \"FLORESTA\", \"LA BOCA\", \"LA PATERNAL\", \"LINIERS\", \"MATADEROS\", \"MONTE CASTRO\", \"MONTSERRAT\", \"NUEVA POMPEYA\", \"NUÑEZ\", \"PALERMO\", \"PARQUE AVELLANEDA\", \"PARQUE CHACABUCO\", \"PARQUE CHAS\", \"PARQUE PATRICIOS\", \"PUERTO MADERO\", \"RECOLETA\", \"RETIRO\", \"SAAVEDRA\", \"SAN CRISTOBAL\", \"SAN NICOLAS\", \"SAN TELMO\", \"VELEZ SARSFIELD\", \"VERSALLES\", \"VILLA CRESPO\", \"VILLA DEL PARQUE\", \"VILLA DEVOTO\", \"VILLA GRL. MITRE\", \"VILLA LUGANO\", \"VILLA LURO\", \"VILLA ORTUZAR\", \"VILLA PUEYRREDON\", \"VILLA REAL\", \"VILLA RIACHUELO\", \"VILLA SANTA RITA\", \"VILLA SOLDATI\", \"VILLA URQUIZA\"]}};\n\n        const hI = document.getElementById('hI'), hF = document.getElementById('hF');\n        hI.add(new Option('Seleccione hora...', '', true, true));\n        hI.options[0].disabled = true;\n        hF.add(new Option('Seleccione hora...', '', true, true));\n        hF.options[0].disabled = true;\n        for(let i=6;i<24;i++){ let t=(i<10?'0':'')+i+':00'; hI.add(new Option(t,t)); hF.add(new Option(t,t)); }\n\n        const cuitIn = document.getElementById('cuit');\n        cuitIn.addEventListener('input', function() { this.value = this.value.replace(/[^0-9]/g, ''); });\n\n        const pS = document.getElementById('provincia'), pSel = document.getElementById('pSel'), bSel = document.getElementById('bSel');\n        pS.onchange = function(){\n            const prov = this.value; \n            pSel.innerHTML = \"\"; pSel.disabled = false;\n            if (prov === 'CABA') {\n                pSel.add(new Option(\"Capital Federal\", \"Capital Federal\"));\n                updateBarrios('CABA', 'Capital Federal');\n            } else {\n                pSel.add(new Option(\"Localidad...\", \"\", true, true));\n                Object.keys(dataUbicacion[prov]).forEach(p => pSel.add(new Option(p, p)));\n                bSel.innerHTML = '<option value=\"\">Elija población</option>'; bSel.disabled = true;\n            }\n        };\n\n        pSel.onchange = function() { updateBarrios(pS.value, this.value); };\n\n        function updateBarrios(prov, popName) {\n            bSel.innerHTML = '<option value=\"\" disabled selected>Barrio...</option>'; bSel.disabled = false;\n            dataUbicacion[prov][popName].forEach(b => bSel.add(new Option(b, b)));\n        }\n\n        function normalizarCelularArgentino(tel) {\n            if (!tel) return null;\n            let digits = tel.toString().replace(/[^0-9]/g, '');\n            if (digits.startsWith('0')) digits = digits.substring(1);\n            if (digits.startsWith('54')) {\n                digits = digits.substring(2);\n                if (digits.startsWith('9')) digits = digits.substring(1);\n            }\n            // Quitar 15 si viene después del código de área (ej: 11 15 12345678 -> 11 12345678)\n            for (let areaLen of [2, 3, 4]) {\n                if (digits.length > areaLen + 2 && digits.substring(areaLen, areaLen + 2) === '15') {\n                    digits = digits.substring(0, areaLen) + digits.substring(areaLen + 2);\n                    break;\n                }\n            }\n            // Los celulares en Argentina con código de área tienen exactamente 10 dígitos (sin el 0 ni el 15)\n            if (digits.length === 10) {\n                return '+549' + digits;\n            }\n            return null;\n        }\n\n        function validarCUIT(c) {\n            c = c.replace(/[^0-9]/g, \"\"); \n            if (c.length !== 11 || /^(\\d)\\1+$/.test(c)) return false; \n            let m = [5, 4, 3, 2, 7, 6, 5, 4, 3, 2], t = 0;\n            for (let i = 0; i < 10; i++) t += parseInt(c[i]) * m[i];\n            let r = t % 11, d = r === 0 ? 0 : r === 1 ? 9 : 11 - r;\n            return d === parseInt(c[10]);\n        }\n\n        function validarCP(cp) {\n            const regex = /(^[0-9]{4}$)|(^[A-Za-z][0-9]{4}[A-Za-z]{3}$)/;\n            return regex.test(cp.trim());\n        }\n\n        document.getElementById('fedirForm').onsubmit = async (e) => {\n            e.preventDefault();\n            const btn = document.getElementById('submitBtn');\n            const diasChecked = Array.from(e.target.querySelectorAll('input[name=\"Dias\"]:checked'));\n            \n            if(diasChecked.length === 0) { alert(\"Marque al menos un día de atención.\"); return; }\n            if (!validarCUIT(cuitIn.value)) { alert(\"CUIT inválido o prohibido.\"); return; }\n            if (!validarCP(document.getElementById('cp').value)) { alert(\"CP inválido (ej: 1002 o C1425ABC).\"); return; }\n            \n            const tel1Input = document.getElementById('tel1');\n            const tel1Normalizado = normalizarCelularArgentino(tel1Input ? tel1Input.value : '');\n            if (!tel1Normalizado) {\n                alert(\"Tel. Whatsapp inválido. Ingrese un celular válido (ej: +54 9 11 2345-6789 o 11 2345-6789).\");\n                return;\n            }\n            if (!hI.value || !hF.value) { alert(\"Debe seleccionar un horario de atención.\"); return; }\n            if (hF.value <= hI.value) { alert(\"La hora de cierre debe ser superior a la de apertura.\"); return; }\n\n            btn.disabled = true; btn.innerText = \"Registrando...\";\n\n            const formData = new FormData(e.target);\n            const data = Object.fromEntries(formData.entries());\n            data.Dias = diasChecked.map(cb => cb.value);\n            data[\"Teléfono 1\"] = tel1Normalizado;\n\n            try {\n                const res = await fetch(WEBHOOK_URL, { method: 'POST', body: JSON.stringify(data), headers: {'Content-Type': 'application/json'} });\n                const htmlResponse = await res.text();\n                document.getElementById('container-fedir').innerHTML = htmlResponse;\n            } catch (err) { alert('Error: Revise n8n.'); btn.disabled = false; }\n        };\n    </script>\n</body>\n</html>",
