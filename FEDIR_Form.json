      "parameters": {
        "respondWith": "text",
        "responseBody": "=<!DOCTYPE html>\n<html lang=\"es\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Nuevo Proveedor - FEDIR</title>\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <style>\n        body { background-color: #f0f2f5; font-family: 'Segoe UI', sans-serif; }\n        .form-card { max-width: 950px; margin: 20px auto; background: white; border-radius: 12px; box-shadow: 0 10px 25px rgba(0,0,0,0.1); padding: 30px; border: 1px solid #e1e4e8; }\n        .main-title { text-align: center; color: #1a202c; font-weight: 900 !important; letter-spacing: -2px; font-size: 34px; margin-bottom: 10px; }\n        @media (min-width: 768px) { .form-card { margin: 40px auto; padding: 50px; } .main-title { font-size: 62px !important; } }\n        .section-title { font-size: 18px; font-weight: 700; color: #2d3748; margin: 30px 0 15px 0; border-bottom: 3px solid #3182ce; padding-bottom: 5px; }\n        .label { display: block; font-size: 14px; color: #4a5568; margin-bottom: 6px; font-weight: 600; }\n        .required { color: #e53e3e; margin-left: 3px; }\n        .input, .select, .textarea { width: 100%; padding: 12px 15px; border: 1px solid #cbd5e0; border-radius: 8px; font-size: 15px; margin-bottom: 18px; outline: none; background: #fff; }\n        .input:focus, .select:focus { border-color: #3182ce; box-shadow: 0 0 0 3px rgba(66, 153, 225, 0.15); }\n        .checkbox-group { display: grid; grid-template-cols: repeat(auto-fill, minmax(115px, 1fr)); gap: 10px; background: #f8fafc; padding: 15px; border-radius: 8px; border: 1px solid #e2e8f0; }\n        .btn { width: 100%; background: #2b6cb0; color: white; padding: 20px; border-radius: 8px; font-weight: 800; font-size: 22px; margin-top: 30px; border: none; cursor: pointer; text-transform: uppercase; }\n        .btn:disabled { background: #cbd5e0; cursor: not-allowed; }\n    </style>\n</head>\n<body>\n    <div id=\"container-fedir\">\n        <div class=\"form-card\">\n            <h1 class=\"main-title\">Nuevo Proveedor FEDIR</h1>\n            <form id=\"fedirForm\">\n                <div class=\"section-title\">Datos Fiscales y Persona de Contacto</div>\n                <div class=\"grid grid-cols-1 md:grid-cols-2 gap-x-6\">\n                    <div><label class=\"label\">Razón Social<span class=\"required\">*</span></label><input type=\"text\" name=\"Razón Social\" required class=\"input\"></div>\n                    <div><label class=\"label\">Nombre Comercial<span class=\"required\">*</span></label><input type=\"text\" name=\"Nombre Comercial\" required class=\"input\"></div>\n                    <div><label class=\"label\">CUIT (11 números)<span class=\"required\">*</span></label><input type=\"tel\" id=\"cuit\" name=\"CUIT\" pattern=\"[0-9]*\" inputmode=\"numeric\" placeholder=\"Sin guiones\" required class=\"input\"></div>\n                    <div><label class=\"label\">Persona de Contacto<span class=\"required\">*</span></label><input type=\"text\" name=\"Persona Contacto\" required class=\"input\"></div>\n                </div>\n\n                <div class=\"grid grid-cols-1 md:grid-cols-3 gap-x-6\">\n                    <div><label class=\"label\">E-mail<span class=\"required\">*</span></label><input type=\"email\" name=\"Email\" required class=\"input\"></div>\n                    <div><label class=\"label\">Tel. Whatsapp<span class=\"required\">*</span></label><input type=\"tel\" id=\"tel1\" name=\"Teléfono 1\" required class=\"input\" placeholder=\"Ej: +54 9 11 2345-6789\"></div>\n                    <div><label class=\"label\">Teléfono 2</label><input type=\"tel\" name=\"Teléfono 2\" class=\"input\"></div>\n                </div>\n\n                <div class=\"section-title\">Ubicación y Código Postal</div>\n                <div class=\"grid grid-cols-1 md:grid-cols-3 gap-x-4\">\n                    <div>\n                        <label class=\"label\">Provincia<span class=\"required\">*</span></label>\n                        <select name=\"Provincia\" id=\"provincia\" required class=\"select\">\n                            <option value=\"\" disabled selected>Elegir...</option>\n                            <option value=\"CABA\">CABA</option>\n                            <option value=\"Buenos Aires\">Buenos Aires</option>\n                        </select>\n                    </div>\n                    <div><label class=\"label\">Población<span class=\"required\">*</span></label><div id=\"pop-cont\"><select id=\"pSel\" name=\"Población\" required class=\"select\" disabled><option value=\"\">Elija provincia</option></select></div></div>\n                    <div><label class=\"label\">Barrio / Localidad<span class=\"required\">*</span></label><div id=\"bar-cont\"><select id=\"bSel\" name=\"Barrio\" required class=\"select\" disabled><option value=\"\">Elija población</option></select></div></div>\n                </div>\n                <div class=\"grid grid-cols-1 md:grid-cols-3 gap-x-4\">\n                    <div class=\"md:col-span-2\"><label class=\"label\">Dirección (Calle y altura)<span class=\"required\">*</span></label><input type=\"text\" name=\"Dirección\" required class=\"input\"></div>\n                    <div><label class=\"label\">CP (Arg)<span class=\"required\">*</span></label><input type=\"text\" id=\"cp\" name=\"CP\" required class=\"input\" placeholder=\"Ej: C1425ABC\"></div>\n                </div>\n\n                <div class=\"section-title\">Horario de Atención</div>\n                <div class=\"grid grid-cols-1 md:grid-cols-2 gap-x-4\">\n                    <div><label class=\"label\">Desde:<span class=\"required\">*</span></label><select id=\"hI\" name=\"Horario Desde\" required class=\"select\"></select></div>\n                    <div><label class=\"label\">Hasta:<span class=\"required\">*</span></label><select id=\"hF\" name=\"Horario Hasta\" required class=\"select\"></select></div>\n                </div>\n\n                <div class=\"section-title\">Días Abierto (Mínimo 1)</div>\n                <div class=\"checkbox-group mb-6\">\n                    <label class=\"flex items-center gap-2 cursor-pointer\"><input type=\"checkbox\" name=\"Dias\" value=\"Lunes\"> Lunes</label>\n                    <label class=\"flex items-center gap-2 cursor-pointer\"><input type=\"checkbox\" name=\"Dias\" value=\"Martes\"> Martes</label>\n                    <label class=\"flex items-center gap-2 cursor-pointer\"><input type=\"checkbox\" name=\"Dias\" value=\"Miércoles\"> Miércoles</label>\n                    <label class=\"flex items-center gap-2 cursor-pointer\"><input type=\"checkbox\" name=\"Dias\" value=\"Jueves\"> Jueves</label>\n                    <label class=\"flex items-center gap-2 cursor-pointer\"><input type=\"checkbox\" name=\"Dias\" value=\"Viernes\"> Viernes</label>\n                    <label class=\"flex items-center gap-2 cursor-pointer\"><input type=\"checkbox\" name=\"Dias\" value=\"Sábado\"> Sábado</label>\n                    <label class=\"flex items-center gap-2 cursor-pointer\"><input type=\"checkbox\" name=\"Dias\" value=\"Domingo\"> Domingo</label>\n                </div>\n\n                <label class=\"label\">Observaciones</label>\n                <textarea name=\"Observaciones\" rows=\"3\" class=\"textarea\"></textarea>\n                <button type=\"submit\" id=\"submitBtn\" class=\"btn shadow-lg\">Registrar en FEDIR</button>\n            </form>\n        </div>\n    </div>\n\n    <script>\n        const WEBHOOK_URL = 'https://n8n.fmsuit.net/webhook/form_fedir';\n        const dataUbicacion = {\"Buenos Aires\": {\"25 de Mayo\": [\"25 de Mayo\", \"Agustín Mosconi\", \"Del Valle\", \"Ernestina\", \"Gobernador Ugarte\", \"Lucas Monteverde\", \"Norberto de la Riestra\", \"Pedernales\", \"San Enrique\", \"Valdés\"], \"9 de Julio\": [\"12 de Octubre\", \"9 de Julio\", \"Alfredo Demarchi\", \"Carlos María Naón\", \"Dennehy\", \"Dudign